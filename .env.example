# ===================================
# Sarthi AI Agents - Environment Variables Example
# ===================================

# Groq API Key (Required for LLM generation in tools/llm.py)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Tavily API Key (Required for Web Search in tools/search.py)
# Get your key at: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Agent Microservice Configuration
AGENT_PORT=8000
AGENT_HOST=0.0.0.0

# Optional Model & Agent Settings
GROQ_MODEL=llama-3.3-70b-versatile
